# Copy to .env.local for local dev. In GitHub Actions these come from repository *variables*
# (Settings > Secrets and variables > Actions > Variables). The anon key is public by design;
# NEVER put the service_role key anywhere in this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Public website base (GitHub Pages) used for privacy/terms links, e.g. https://USER.github.io/REPO
VITE_WEB_BASE_URL=
VITE_SUPPORT_EMAIL=
